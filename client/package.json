{
  "name": "@nostalgia/client",
  "private": true,
  "version": "1.0.0",
  "description": "Nostalgia - retro game launcher with cloud saves",
  "author": "Nostalgia",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@nostalgia/shared": "*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.10.2",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
